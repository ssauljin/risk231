%----------------------------------------------------------------------
% Timelines
%----------------------------------------------------------------------
% Size of the labels in \timeline and \cfdiagram
% (a chapter may use \renewcommand{\tlsize}{\footnotesize})
\newcommand{\tlsize}{\scriptsize}

% \timeline[ellipsis positions]{length}{position/label pairs}
%   ticks with time labels below; optional "..." below the given positions
\newcommand{\timeline}[3][]{%
  \begin{tikzpicture}
    \draw (0,0) -- (#2,0);
    \foreach \x/\lab in {#3} {
      \draw (\x,0.12) -- (\x,-0.12);
      \node[below] at (\x,-0.12) {\tlsize $\lab$};
    }
    \foreach \x in {#1} {
      \node[below] at (\x,-0.12) {\tlsize $\ldots$};
    }
  \end{tikzpicture}%
}

% \cfdiagram[extra tikz]{length}{position/time-label pairs}{position/amount pairs}
%   ticks with time labels below and amounts above
\newcommand{\cfdiagram}[4][]{%
  \begin{tikzpicture}
    \draw (0,0) -- (#2,0);
    \foreach \x/\lab in {#3} {
      \draw (\x,0.12) -- (\x,-0.12);
      \node[below] at (\x,-0.12) {\tlsize $\lab$};
    }
    \foreach \x/\amt in {#4} {
      \node[above] at (\x,0.12) {\tlsize \amt};
    }
    #1
  \end{tikzpicture}%
}

% \cftimeline{length}{position/time-label/amount triples}{extra tikz}
%   same idea as \cfdiagram, one triple per tick, \small labels
\newcommand{\cftimeline}[3]{%
  \begin{tikzpicture}
    \draw (0,0) -- (#1,0);
    \foreach \x/\lab/\amt in {#2} {
      \draw (\x,0.12) -- (\x,-0.12);
      \node[below] at (\x,-0.12) {\small $\lab$};
      \node[above] at (\x,0.12) {\small \amt};
    }
    #3
  \end{tikzpicture}%
}

% \cfrows{length}{position/label pairs}{colour/row-label pairs}
%   timeline with coloured row labels underneath
\newcommand{\cfrows}[3]{%
  \begin{tikzpicture}
    \draw (0,0) -- (#1,0);
    \foreach \x/\lab in {#2} {
      \draw (\x,0.12) -- (\x,-0.12);
      \node[below] at (\x,-0.12) {\scriptsize $\lab$};
    }
    \foreach \c/\rlab [count=\k] in {#3} {
      \node[anchor=west, text=\c] at (-3,-0.25-0.6*\k) {\small \rlab};
    }
  \end{tikzpicture}%
}

%----------------------------------------------------------------------
% Code listings (Excel formulas, VBA, R, SQL)
%----------------------------------------------------------------------
% Usage (the frame must be [fragile]):
%   \begin{lstlisting}[language=VBA] ... \end{lstlisting}
%   languages: VBA, R, SQL;  output/console text: style=output
%   inline: \code{SUM(A1:A10)}  or  \lstinline[language=R]|x <- 1|
\lstdefinelanguage{VBA}[Visual]{Basic}{%
  morekeywords={Sub,Function,Dim,As,Set,Range,Cells,Worksheets,Workbooks,
    ActiveSheet,ActiveCell,Selection,Application,MsgBox,InputBox,Integer,Long,
    Double,String,Boolean,Variant,Object,ElseIf,Each,Exit,With,Option,Explicit,
    Private,Public,Const,ByVal,ByRef,Do,Loop,Until,While,Wend,Select,Case},
  sensitive=false}
\lstset{
  basicstyle=\ttfamily\scriptsize,
  keywordstyle=\color{blue!70!black}\bfseries,
  commentstyle=\color{dgreen}\itshape,
  stringstyle=\color{purple},
  columns=fullflexible, keepspaces=true,
  breaklines=true, showstringspaces=false,
  frame=single, rulecolor=\color{black!25},
  backgroundcolor=\color{black!3},
  xleftmargin=2pt, xrightmargin=2pt, aboveskip=4pt, belowskip=4pt,
  upquote=true}
\lstdefinestyle{output}{basicstyle=\ttfamily\scriptsize\color{black!75},
  backgroundcolor=\color{white}, frame=leftline, keywordstyle={},
  commentstyle={}, stringstyle={}}
\newcommand{\code}[1]{\texttt{\color{blue!50!black}#1}}

% Blank space for fill-in rows such as "F = ...  C = ..."
\newcommand{\blank}{\hspace{1.2cm}}

\endinput
