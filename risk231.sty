% \setchapter{N}: number sections N.1, N.2, ...
\newcommand{\setchapter}[1]{\renewcommand{\thesection}{#1.\arabic{section}}}

% \sectionframe: a divider slide showing the current \section title
\setbeamertemplate{section page}{%
  \centering\vfill
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\insertsectionhead\par}%
  \vfill}
\newcommand{\sectionframe}{\begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}

