% risk231.sty -- shared style for the RISK 231 Beamer lecture notes
%
% Usage in a chapter file:
%   \documentclass{beamer}
%   \usepackage{risk231}
%   \setchapter{4}                  % sections numbered 4.1, 4.2, ...
%   \title{RISK 231: <Chapter name>}
%
% Figures live in figures/chNN/ and are included as
%   \includegraphics{chNN/<file>}   (see \graphicspath below)
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{risk231}[2026/11/03 RISK 231 lecture slides]

%----------------------------------------------------------------------
% Beamer appearance (from Slides_sample.TEX)
%----------------------------------------------------------------------
\mode<presentation> {\usetheme{default}}
%\setbeamersize{text margin left=10mm,text margin right=10mm}
\setbeamertemplate{footline}[frame number]

